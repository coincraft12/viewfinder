# viewfinder-signal-server 전용 (custody-staging에 배포됨) — 실제 값은 .env에 넣기, git 커밋 안 됨
# 클립 목록(/clips)과 재생(/file)에 필요한 Hetzner Storage Box 계정 정보.
# 로컬 PC의 hetzner-upload-relay.js와 같은 계정(읽기 전용 용도로만 사용).
WEBDAV_URL=https://uXXXXXX.your-storagebox.de
WEBDAV_USER=uXXXXXX
WEBDAV_PASS="여기에_비밀번호_따옴표로_감싸기"
WEBDAV_PREFIX=viewfinder-motion/
SIGNAL_PORT=8790
